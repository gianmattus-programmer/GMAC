# URL del Web App de Google Apps Script (Implementar -> Nueva implementación -> Aplicación web)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_IMPLEMENTACION/exec

# Misma clave guardada en Apps Script -> Propiedades del script -> API_SECRET
SHEETS_API_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_PRIVADA

# Clave adicional para las rutas /api/admin/* de Vercel y ADMIN_SECRET en Apps Script
ADMIN_SECRET=OTRA_CLAVE_LARGA_Y_PRIVADA
